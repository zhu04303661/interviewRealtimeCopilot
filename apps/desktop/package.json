{
  "name": "interview-realtime-copilot",
  "productName": "Interview Realtime Copilot",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time interview copilot: bilingual live transcript, question extraction, grounded answer hints and spoken practice interviews.",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:native && npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "start": "npm run build && electron .",
    "app": "npm run build && open -n node_modules/electron/dist/Electron.app --args \"$PWD\"",
    "build:native": "node scripts/build-native.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
