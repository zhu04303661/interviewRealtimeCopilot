# The China entry (Shenzhen): serves the pages and installers itself and proxies /api and /auth to the main site.
# Read by deploy.sh (so the main site accepts it) and deploy-mirror.sh. SSH is by key; no secrets here.
MIRROR_SSH=xichi@8.155.147.19
MIRROR_DOMAIN=copilot.xichigroup.com.cn
MIRROR_ORIGIN=https://copilot.xichigroup.com.cn
MIRROR_IP=8.155.147.19
MAIN_HOST=copilot.xichiuk.com
# Installer downloads from Alibaba Cloud OSS (public-read bucket). Uploads run on the mirror server with ossutil over the
# internal endpoint; its credentials live only there (~/.ossutilconfig). Leave OSS_BUCKET empty to serve the DMG from the servers.
OSS_BUCKET=
OSS_REGION=cn-heyuan
